# Server
NODE_ENV=development
PORT=5000
APP_NAME=SalesPilot AI
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/salespilot_ai?retryWrites=true&w=majority
MONGODB_VECTOR_INDEX_NAME=knowledge_chunks_vector_index

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-256-bit-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-256-bit-secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ENCRYPTION_KEY=replace-with-32-byte-hex-encryption-key

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# AI / LLM & Embeddings
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voice: Deepgram STT & ElevenLabs TTS
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Telephony: Twilio / Exotel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/integrations/google-calendar/callback

# Email (Nodemailer / Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SalesPilot AI <no-reply@salespilot.ai>"

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
